{
  "schema_version": 1,
  "name": "thinkjepa_baseline",
  "description": "Public ThinkJEPA trajectory baseline used as the fixed MG comparison control.",
  "source_baseline_commit": "9b95d358f7c7a1eaf73fda0efbcc8e28c44ce086",
  "trainer_args": {
    "epochs": 100,
    "predictor": "thinkjepa",
    "backbone": "vjepa",
    "trajmode": "traj",
    "joint_pred": true,
    "ref_mode": "none",
    "optimize_together_downstream": true,
    "lambda_pred": 1.0,
    "lambda_task": 1.0,
    "lr": 0.001,
    "lr_pred": 0.0001,
    "seed": 42,
    "train_ratio": 0.9,
    "split_seed": 42,
    "train_batch_size": 2,
    "test_batch_size": 2,
    "num_workers": 2,
    "prefetch_factor": 1,
    "past_T": 32,
    "future_T": 32,
    "temporal_stride": 1,
    "camera_mode": "auto",
    "thinkjepa_vlm_source": "both",
    "thinkjepa_vlm_layer_selector": "last",
    "thinkjepa_vlm_cond_mode": "film",
    "max_visual_batches": 1,
    "use_npz_cache": true,
    "skip_vjepa": true,
    "no_preload_cache_to_memory": true,
    "no_amp": false,
    "skip_nonfinite_loss": false
  }
}
